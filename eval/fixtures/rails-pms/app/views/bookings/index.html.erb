<% content_for :title, "Book a stay · Rails PMS" %>

<h1>Book a stay</h1>
<% if @error %>
  <p class="error"><%= @error %></p>
<% end %>

<%= form_with url: book_path, method: :post, class: "card" do %>
  <label for="guest_name">Your name</label>
  <input id="guest_name" name="guest_name" required />

  <label for="email">Email</label>
  <input id="email" name="email" type="email" required />

  <label for="phone">Phone</label>
  <input id="phone" name="phone" required />

  <label for="check_in">Check in</label>
  <input id="check_in" name="check_in" type="date" required />

  <label for="check_out">Check out</label>
  <input id="check_out" name="check_out" type="date" required />

  <label for="party_size">Guests</label>
  <input id="party_size" name="party_size" type="number" min="1" max="20" value="1" />

  <label for="space_id">Space</label>
  <select id="space_id" name="space_id">
    <option value="">Let the front desk assign one</option>
    <% @spaces.each do |space| %>
      <option value="<%= space.id %>">
        <%= space.name %> · <%= space.kind_label %> · sleeps <%= space.capacity %>
      </option>
    <% end %>
  </select>

  <label for="notes">Notes</label>
  <textarea id="notes" name="notes" rows="3"></textarea>

  <p><button type="submit">Request booking</button></p>
<% end %>
