{
  "name": "@seamapi/wizard",
  "version": "0.44.2",
  "description": "The AI powered Seam setup wizard.",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "module": "index.js",
  "sideEffects": false,
  "keywords": [
    "node"
  ],
  "homepage": "https://github.com/seamapi/wizard",
  "bugs": "https://github.com/seamapi/wizard/issues",
  "repository": "seamapi/wizard",
  "license": "MIT",
  "author": {
    "name": "Seam Labs, Inc.",
    "email": "devops@getseam.com"
  },
  "files": [
    "index.js",
    "index.js.map",
    "index.d.ts",
    "lib",
    "src",
    "!src/bin",
    "!test",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "scripts": {
    "build": "npm run build:entrypoints",
    "prebuild": "tsx src/index.ts",
    "postbuild": "node ./index.js",
    "build:entrypoints": "npm run build:ts",
    "build:ts": "tsc --project tsconfig.build.json",
    "prebuild:ts": "del 'index.*' lib",
    "postbuild:ts": "tsc-alias --project tsconfig.build.json",
    "typecheck": "tsc",
    "test": "vitest run --coverage",
    "pretest": "tsx src/index.ts",
    "test:update": "vitest run --update",
    "test:watch": "vitest",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "lint": "eslint .",
    "postlint": "prettier --check --ignore-path .gitignore --ignore-path .prettierignore .",
    "prepack": "tsx ./prepack.ts",
    "postversion": "git push --follow-tags",
    "seam": "tsx src/bin/cli.ts",
    "wizard": "tsx src/bin/cli.ts wizard",
    "inspect": "tsx --inspect src/bin/cli.ts wizard",
    "format": "prettier --write --ignore-path .gitignore --ignore-path .prettierignore .",
    "preformat": "eslint --fix .",
    "report": "vitest run --coverage",
    "screen": "tsx src/bin/screen.ts",
    "eval": "tsx eval/run.ts"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.11.0 || ^22.12.0"
    },
    "packageManager": {
      "name": "npm",
      "version": "^11.0.0 || ^10.0.0"
    }
  },
  "packageManager": "npm@11.19.0",
  "peerDependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.8"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.216",
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@seamapi/http": "^2.23.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "minimist": "^1.2.8",
    "open": "^11.0.0",
    "pi-mcp-adapter": "^2.27.0"
  },
  "devDependencies": {
    "@seamapi/cli": "^0.34.0",
    "@types/minimist": "^1.2.5",
    "@types/node": "^24.10.9",
    "@types/react": "^19.2.17",
    "@vitest/coverage-v8": "^4.1.10",
    "del-cli": "^7.0.0",
    "eslint": "^9.31.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "execa": "^10.0.0",
    "ink": "^7.1.1",
    "ink-testing-library": "^4.0.0",
    "neostandard": "^0.13.0",
    "prettier": "^3.0.0",
    "react": "^19.2.8",
    "tsc-alias": "^1.8.2",
    "tsx": "^4.6.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
